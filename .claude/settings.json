{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.md) cd \"${CLAUDE_PROJECT_DIR:-.}\" && npm run lint:md >&2 || exit 2; if grep -q '^```mermaid' \"$f\"; then npm run lint:mermaid >&2 || exit 2; fi;; esac; }",
            "timeout": 180,
            "statusMessage": "markdownlint（Mermaid ブロックがあれば mermaid も）..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "kizuna hook session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "kizuna hook session-end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "kizuna hook prompt-submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "kizuna hook stop"
          }
        ]
      }
    ]
  }
}
